[sub_resource type="Shader" id="Shader_7mycd"]
code = "shader_type canvas_item;

uniform float scanline_intensity : hint_range(0.0, 1.0) = 0.15;
uniform float scanline_count : hint_range(100.0, 500.0) = 250.0;
uniform float vignette_intensity : hint_range(0.0, 1.0) = 0.3;

void fragment() {
    vec4 color = texture(TEXTURE, UV);
    
    // Scanline efekti
    float scanline = sin(UV.y * scanline_count) * 0.5 + 0.5;
    color.rgb -= scanline * scanline_intensity;
    
    // Vignette (kenar karartma)
    vec2 uv = UV * (1.0 - UV);
    float vignette = uv.x * uv.y * 15.0;
    vignette = pow(vignette, vignette_intensity);
    color.rgb *= vignette;
    
    COLOR = color;
}"

